{{ if eq .platform "windows" -}}
# Windows common CLI and runtimes; native AI installers have separate ownership.
env = ["windows"]
{{ else if eq .platform "macos" -}}
env = ["ai", "macos"]
{{ else -}}
{{- $envs := list -}}
{{- if .features.ai -}}{{- $envs = append $envs "ai" -}}{{- end -}}
{{- if dig "features" "managed_ai" false . -}}{{- $envs = append $envs "ai-managed" -}}{{- end -}}
{{- if .features.personal_fedora -}}{{- $envs = append $envs "personal-fedora" -}}{{- end -}}
{{- if and (eq .platform "ubuntu") .features.editor_web -}}{{- $envs = append $envs "editor-ubuntu" -}}{{- end -}}
{{- if and (has .platform (list "arch" "opensuse-tumbleweed")) .features.editor_web -}}{{- $envs = append $envs "editor-web" -}}{{- end -}}
# Machine selection. Presence of config.<environment>.toml alone does not select it.
env = [{{ range $index, $value := $envs }}{{ if $index }}, {{ end }}{{ $value | quote }}{{ end }}]
{{ end -}}
