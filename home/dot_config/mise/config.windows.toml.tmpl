{{- $ai := (include "dot_config/mise/config.ai-managed.toml" | fromToml).tools -}}
{{- if ne (index $ai "grok") .windows.grok.version -}}
{{- fail "Windows Grok checksum metadata must match the shared tool version." -}}
{{- end -}}
# Native Windows fallbacks. WinGet tools are deliberately absent.
[tools]
"npm:@earendil-works/pi-coding-agent" = { version = {{ (index $ai "npm:@earendil-works/pi-coding-agent").version | quote }}, allow_builds = false }
"pipx:aider-chat" = { version = {{ (index $ai "pipx:aider-chat").version | quote }}, uvx = true, uvx_args = "--python 3.12" }
[tools."http:grok"]
version = {{ (index $ai "grok") | quote }}
bin = "grok.exe"
url = {{ .windows.grok.url | quote }}
checksum = {{ .windows.grok.sha256 | quote }}
