# Prepare after Carapace re-sources the library, before its actual callback.
_sc_prepare_bridge() {
  if [[ $BASH_COMMAND == __load_completion* ]]; then
    if [[ -n ${SC_BASH_WORDS-} ]]; then
      IFS=$'\x1f' read -r -a COMP_WORDS <<< "$SC_BASH_WORDS"
      [[ $SC_BASH_WORDS == *$'\x1f' ]] && COMP_WORDS+=("")
      COMP_CWORD=$((${#COMP_WORDS[@]}-1))
      COMP_LINE=$SC_BASH_LINE
      COMP_POINT=${#COMP_LINE}
    fi
    local provider=${_SC_BRIDGE_SOURCE[${COMP_WORDS[0]}]-}
    [[ -n $provider ]] && source "$provider"
  fi
  if [[ $BASH_COMMAND == *'complete -p "${COMP_WORDS[0]}"'* ]]; then
    trap - DEBUG
    # __load_completion re-loads the system provider; apply wall's override last.
    if [[ ${COMP_WORDS[0]} == wall ]]; then
      source "$HOME/.config/shell-completion/wall.bash"
    fi
    source "$HOME/.config/shell-completion/bridge-safe.bash"
  fi
  return 0
}
