{{- /* chezmoi:modify-template */ -}}
{{- $text := .chezmoi.stdin -}}
{{- $line := `[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"` -}}
{{- if not (has $line (splitList "\n" $text)) -}}
{{- $text = printf "%s\n\n# Homebrew login environment; retain existing login customizations.\n%s\n" (trimSuffix "\n" $text) $line -}}
{{- end -}}
{{- $text -}}
