{{- /* chezmoi:modify-template */ -}}
{{- if eq .platform "ubuntu" -}}
{{- $text := .chezmoi.stdin -}}
{{- $line := `[[ -r "$HOME/.config/shell/bashrc.bash" ]] && source "$HOME/.config/shell/bashrc.bash"` -}}
{{- if has $line (splitList "\n" $text) -}}
{{- $text -}}
{{- else -}}
{{- printf "%s\n\n# Shared CLI settings; preserve Ubuntu's existing Bash configuration above.\n%s\n" (trimSuffix "\n" $text) $line -}}
{{- end -}}
{{- else -}}
{{ includeTemplate "shell/fedora.bashrc.tmpl" . }}
{{- end -}}
