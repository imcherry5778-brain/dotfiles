{{- /* init does not include source/override data by default. Read persisted
       machine data explicitly; honour the reviewed override file for init too. */ -}}
{{- if eq .chezmoi.command "init" -}}
{{- $defaults := include (joinPath .chezmoi.sourceDir ".chezmoidata.toml") | fromToml -}}
{{- $_ := mergeOverwrite . $defaults .chezmoi.config.data -}}
{{- range $index, $argument := .chezmoi.args -}}
{{- if eq $argument "--override-data-file" -}}
{{- $selection := include (index $.chezmoi.args (add1 $index)) | fromJson -}}
{{- $_ := mergeOverwrite $ $selection -}}
{{- else if hasPrefix "--override-data-file=" $argument -}}
{{- $selection := include (trimPrefix "--override-data-file=" $argument) | fromJson -}}
{{- $_ := mergeOverwrite $ $selection -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $platform := .chezmoi.os -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $platform = .chezmoi.osRelease.id -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{-   $platform = "macos" -}}
{{- end -}}
{{- if hasKey . "platform" -}}
{{-   $platform = .platform -}}
{{- end -}}
{{- if not (has $platform (list "fedora" "ubuntu" "arch" "opensuse-tumbleweed" "macos" "windows")) -}}
{{-   fail (printf "Unsupported platform %q. Review docs/platforms.md before initialization." $platform) -}}
{{- end -}}
{{- $family := "linux" -}}
{{- if eq $platform "macos" -}}{{- $family = "darwin" -}}{{- end -}}
{{- if eq $platform "windows" -}}{{- $family = "windows" -}}{{- end -}}
{{- if ne $family .chezmoi.os -}}
{{-   fail "Configured platform does not match the current operating system." -}}
{{- end -}}
{{- /* init without --apply remains a configuration-only preview. On a fresh
       native init --apply, select the portable full profile automatically.
       Active machine selections remain unchanged; a disabled preview can opt in. */ -}}
{{- $initialized := and (hasKey . "initialized") .initialized -}}
{{- $install := and (eq .chezmoi.command "init") (has "--apply" .chezmoi.args) (not (and $initialized .deployment.enabled)) -}}
{{- $automation := or (dig "automation" "enabled" false .) $install -}}
{{- if and $install (not .deployment.enabled) -}}
{{- $profile := include (joinPath .chezmoi.workingTree "tests" "profiles" (printf "%s-full.json" $platform)) | fromJson -}}
{{- $_ := mergeOverwrite . $profile -}}
{{- end -}}
{{- /* Reject explicit profile replacement before init can overwrite machine data. */ -}}
{{- if and $initialized (dig "deployment" "enabled" false .chezmoi.config.data) -}}
{{- $existing := .chezmoi.config.data -}}
{{- range $section := list "platform" "features" "deployment" -}}
{{- $old := get $existing $section -}}
{{- $new := get $ $section -}}
{{- if eq $section "features" -}}
{{- $old = deepCopy $old -}}
{{- $new = deepCopy $new -}}
{{- range $optional := list "managed_ai" "desktop" -}}
{{- if not (hasKey $old $optional) -}}{{- $_ := set $old $optional false -}}{{- end -}}
{{- if not (hasKey $new $optional) -}}{{- $_ := set $new $optional false -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- if ne ($old | toJson) ($new | toJson) -}}
{{- fail (printf "Existing %s selection differs; review migration instead of replacing it." $section) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $_ := set . "platform" $platform -}}
{{- $_ := set . "automation" (dict "enabled" $automation) -}}
{{- $document := dict -}}
{{- if stat .chezmoi.configFile -}}
{{- $document = include .chezmoi.configFile | fromToml -}}
{{- end -}}
{{- $desired := includeTemplate "install/machine.toml.tmpl" . | fromToml -}}
{{- if and $automation (eq .chezmoi.command "init") (not .chezmoi.flags.dryRun) (eq .chezmoi.destDir .chezmoi.homeDir) (stat .chezmoi.configFile) -}}
{{- if eq .chezmoi.os "windows" -}}
{{- /* A PS7 -> chezmoi -> PS5.1 process chain inherits incompatible module
       paths. Prefer installed PS7; a pre-bootstrap preview can still use PS5.1. */ -}}
{{- $backupShell := lookPath "pwsh" | default "powershell.exe" -}}
{{- $_ := output $backupShell "-NoProfile" "-ExecutionPolicy" "Bypass" "-File" (joinPath .chezmoi.workingTree "scripts/windows/backup-init.ps1") .chezmoi.configFile -}}
{{- else -}}
{{- $_ := output "sh" (joinPath .chezmoi.workingTree "scripts/unix/backup-init.sh") .chezmoi.configFile -}}
{{- end -}}
{{- end -}}
{{- mergeOverwrite $document $desired | toToml -}}
